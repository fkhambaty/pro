# Trackable Vite env template (root `.gitignore` ignores `.env.*`).
# Copy to `.env.local` for local development.

VITE_SUPABASE_URL=https://your-staging-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key

# Local stack (after `supabase start`):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<anon key from `supabase status`>

# Auth receptionist + analytics run as Vercel edge functions. For local auth
# (`vercel dev` on :3000 with Vite proxying `/api/auth`), also set:
# SUPABASE_URL=…
# SUPABASE_ANON_KEY=…
# SUPABASE_SERVICE_ROLE_KEY=…   # auth rate limits + /api/collect only
# PUBLIC_SITE_URL=http://127.0.0.1:5180
# RATE_LIMIT_SALT=okavo-edge-v1
# AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
